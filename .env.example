# Copy this file to backend/.env and fill in your key.

# Port the Go AI backend listens on. client/vite.config.ts proxies
# /api/partner/ai to this port during local dev.
# (4000 is avoided — commonly taken by Local.app / other local dev tools.)
PORT=4100

# Required for the AI chat endpoint to work. Get a free key at
# https://aistudio.google.com/apikey (Google AI Studio, free tier for testing).
GEMINI_API_KEY=

# Optional — defaults to gemini-3.5-flash-lite. Model availability/naming shifts
# fast; if this 404s as deprecated, the error message names the current
# replacement model — swap it in here.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional — CORS origin allowed to call this API directly (not needed for the
# Vite dev proxy, which talks to this server-to-server)
CORS_ORIGIN=*
